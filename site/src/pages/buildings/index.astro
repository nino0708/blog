---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BuildingCard from '../../components/BuildingCard.astro';
import Pager from '../../components/Pager.astro';
import AreaFilter from '../../components/AreaFilter.astro';
import { buildAreaFacets } from '../../lib/area';
import { useT } from '../../i18n/ui';
import { getBuildingEntries, areaKeysForBuildings } from '../../lib/category';

const lang = 'ja';
const t = useT(lang);
// 橋は /bridges/ に分けたのでここには出さない。
const allPosts = await getBuildingEntries();

// 1ページ10件・新着順。11件目以降は /buildings/page/2/ … へ。
const PER_PAGE = 10;
const totalPages = Math.max(1, Math.ceil(allPosts.length / PER_PAGE));
// エリア絞り込みは全記事から選ぶので一覧は全件出力し、先頭 PER_PAGE 件だけを見せる。
const areaKeys = areaKeysForBuildings(allPosts);
const areaFacets = buildAreaFacets(allPosts.map((p) => areaKeys.get(p.slug) ?? []), lang);
---
<BaseLayout title={t('nav.home')} description={t('buildings.lead')} lang={lang} altPath="/en/buildings/">
  <div class="section-head section-head-sub" data-reveal>
    <p class="crumb"><a href="/">{t('breadcrumb.home')}</a></p>
    <h1>{t('nav.home')}</h1>
    <p>{t('buildings.lead')}</p>
  </div>

  <AreaFilter lang={lang} facets={areaFacets} total={allPosts.length} perPage={PER_PAGE} />

  <section class="grid grid-2">
    {allPosts.map((post, i) => (
      <BuildingCard
        lang={lang}
        url={`/buildings/${post.slug}/`}
        title={post.data.title}
        buildingType={post.data.buildingType}
        area={post.data.area}
        completedYear={post.data.completedYear}
        heightM={post.data.heightM}
        summary={post.data.summary}
        verified={post.data.verified}
        heroImage={post.data.heroImage}
        areas={areaKeys.get(post.slug)}
        areaExtra={i >= PER_PAGE}
      />
    ))}
  </section>

  <div data-area-pager>
    <Pager current={1} total={totalPages} basePath="/buildings/" lang={lang} />
  </div>
</BaseLayout>
