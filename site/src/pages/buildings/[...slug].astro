---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BuildingArticle from '../../components/BuildingArticle.astro';
import { buildSpecs } from '../../i18n/ui';
import { getBuildingRows, nearestTo } from '../../lib/buildings';

export async function getStaticPaths() {
  const posts = await getCollection('buildings');
  const enSlugs = new Set((await getCollection('buildings-en')).map((p) => p.slug));
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, hasEn: enSlugs.has(post.slug) },
  }));
}

const lang = 'ja';
const { post, hasEn } = Astro.props;
const { Content } = await post.render();
const d = post.data;

const pageUrl = new URL(`/buildings/${post.slug}/`, Astro.site ?? 'https://example.com').toString();
const metaDescription =
  d.summary ?? `${d.title}（${d.area}${d.completedYear ? `・${d.completedYear}年竣工` : ''}）の建築・再開発の記録。`;

// 構造化データ: 記事(Article) + 主題の建物(該当する建築タイプ)
const buildingLd: Record<string, unknown> = {
  '@type': d.buildingType === 'residence' ? 'ApartmentComplex' : 'LandmarksOrHistoricalBuildings',
  name: d.title,
  address: { '@type': 'PostalAddress', addressLocality: d.area, addressRegion: '東京都', addressCountry: 'JP' },
};
if (d.address) (buildingLd.address as Record<string, unknown>).streetAddress = d.address;
const base = (Astro.site ?? new URL('https://example.com')).toString().replace(/\/$/, '');
const iso = d.publishedAt.toISOString();
// Article(画像/更新日/著者/発行者ロゴまで補完しリッチリザルト対象に) + パンくずを1つの@graphで出力。
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: d.title,
      description: metaDescription,
      inLanguage: 'ja',
      datePublished: iso,
      dateModified: iso,
      mainEntityOfPage: pageUrl,
      ...(d.heroImage ? { image: [d.heroImage] } : {}),
      author: { '@type': 'Organization', name: 'Built Japan', url: `${base}/` },
      publisher: {
        '@type': 'Organization',
        name: 'Built Japan',
        logo: { '@type': 'ImageObject', url: `${base}/ogp.png` },
      },
      about: buildingLd,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ホーム', item: `${base}/` },
        { '@type': 'ListItem', position: 2, name: 'ビル・マンション', item: `${base}/buildings/` },
        { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
      ],
    },
  ],
};

const specs = buildSpecs(lang, d);
const altPath = hasEn ? `/en/buildings/${post.slug}/` : null;

// 検索意図に寄せたSEOタイトル(建物名｜竣工年・高さ｜エリア+用途)。H1はd.titleのまま。
const typeLabelJa = d.buildingType === 'residence' ? 'マンション' : d.buildingType === 'bridge' ? '橋' : 'オフィスビル';
const factBits = [
  d.completedYear ? `${d.completedYear}年竣工` : null,
  d.heightM ? `高さ${d.heightM}m` : null,
].filter(Boolean).join(' ');
const seoTitle = `${d.title}｜${factBits ? `${factBits}｜` : ''}${d.area}の${typeLabelJa}`;

// 内部リンク用の関連記事: 同エリア優先、次に竣工年が近い順。最大4件。
const related = (await getCollection('buildings'))
  .filter((p) => p.slug !== post.slug)
  .map((p) => {
    const sameArea = p.data.area === d.area ? 1000 : 0;
    const gap = d.completedYear && p.data.completedYear ? Math.abs(p.data.completedYear - d.completedYear) : 999;
    return { p, score: sameArea - gap };
  })
  .sort((a, b) => b.score - a.score)
  .slice(0, 4)
  .map(({ p }) => ({ title: p.data.title, area: p.data.area, href: `/buildings/${p.slug}/` }));

// 近くの建物: 図鑑と同じ全建物（記事未執筆のスタブ含む）から直線距離順に。座標が無ければ何も出さない。
const rows = await getBuildingRows(lang);
const nearby =
  typeof d.lat === 'number' && typeof d.lng === 'number'
    ? nearestTo(rows, d.lat, d.lng, { limit: 6, radiusM: 3000, excludeSlug: post.slug }).map((r) => ({
        title: r.title,
        area: r.area,
        distanceM: r.distanceM,
        href: r.hasArticle ? `/buildings/${r.slug}/` : null,
      }))
    : [];
const nearHref =
  typeof d.lat === 'number' && typeof d.lng === 'number'
    ? `/near/?lat=${d.lat}&lng=${d.lng}&name=${encodeURIComponent(d.title)}`
    : undefined;
---
<BaseLayout title={seoTitle} description={metaDescription} lang={lang} ogType="article" altPath={altPath} jsonLd={jsonLd} appendSiteName={false} ogImage={d.heroImage}>
  <BuildingArticle
    lang={lang}
    title={d.title}
    summary={d.summary}
    related={related}
    area={d.area}
    buildingType={d.buildingType}
    verified={d.verified}
    heroImage={d.heroImage}
    heroImageCredit={d.heroImageCredit}
    heroImageLink={d.heroImageLink}
    specs={specs}
    tags={d.tags}
    tagBase="/tags/"
    sources={d.sources}
    listPath="/buildings/"
    lat={d.lat}
    lng={d.lng}
    slug={post.slug}
    nearby={nearby}
    nearHref={nearHref}
    mapLabel={d.title}
  >
    <Content />
  </BuildingArticle>
</BaseLayout>
