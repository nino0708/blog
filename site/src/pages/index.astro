---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import registryData from '../data/buildings-registry.json';
import { useT } from '../i18n/ui';
import { getAllPosts } from '../lib/latest';
import { BRIDGES, CATEGORIES } from '../lib/category';

const lang = 'ja';
const t = useT(lang);

// トップは「新着」。ビル・マンションに限らず全カテゴリから直近10本を新しい順に出す。
// カテゴリごとの一覧・ページ送りは各カテゴリページ(/buildings/ など)が担う。
const allPosts = await getAllPosts(lang);
const latest = allPosts.slice(0, 10);

// ヒーローのスタッツ用カウント（図鑑と同じ母数: レジストリ ∪ 建物記事）。
const buildingPosts = await getCollection('buildings');
const slugs = new Set<string>((registryData as any).buildings.map((b: any) => b.slug));
for (const p of buildingPosts) slugs.add(p.slug);
const buildingCount = slugs.size;
const articleCount = allPosts.length;
---
<BaseLayout title="Built Japan" lang={lang} altPath="/en/">
  <section class="home-hero">
    <div class="home-hero-inner" data-reveal>
      <p class="eyebrow">{t('home.eyebrow')}</p>
      <h1>{t('home.title')}</h1>
      <p class="home-hero-desc">{t('home.desc')}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/database/">{t('home.cta.database')}</a>
        <a class="btn btn-ghost" href="/rankings/">{t('home.cta.rankings')}</a>
      </div>
      <ul class="hero-stats">
        <li><b>{buildingCount}</b><span>{t('home.stat.buildings')}</span></li>
        <li><b>{articleCount}</b><span>{t('home.stat.articles')}</span></li>
        <li><b>JP / EN</b><span>{t('home.stat.bilingual')}</span></li>
      </ul>
    </div>
    <div class="hero-skyline" aria-hidden="true"></div>
  </section>

  <div class="section-head" data-reveal>
    <h2>{t('home.section.feed')}</h2>
    <p>{t('home.section.feed.desc')}</p>
  </div>

  <section class="grid grid-2">
    {latest.map((post) => <PostCard lang={lang} post={post} />)}
  </section>

  <nav class="feed-more" aria-label={t('footer.categories')}>
    <a href="/buildings/">{t('nav.home')}</a>
    <a href="/expressways/">{CATEGORIES.expressways.label.ja}</a>
    <a href="/railways/">{CATEGORIES.railways.label.ja}</a>
    <a href="/bridges/">{BRIDGES.label.ja}</a>
    <a href="/tourism/">{CATEGORIES.tourism.label.ja}</a>
  </nav>
</BaseLayout>
