---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import registryData from '../../data/buildings-registry.json';
import { useT } from '../../i18n/ui';
import { getAllPosts } from '../../lib/latest';
import { CATEGORIES } from '../../lib/category';

const lang = 'en';
const t = useT(lang);

// 英語トップも「新着」。英語版が存在する記事だけをカテゴリ横断で新しい順に出す。
const allPosts = await getAllPosts(lang);
const latest = allPosts.slice(0, 10);

// 建物の収録数は言語共通の母数(レジストリ ∪ 記事)。記事数は英語化済みの本数。
const jp = await getCollection('buildings');
const slugs = new Set<string>((registryData as any).buildings.map((b: any) => b.slug));
for (const p of jp) slugs.add(p.slug);
const buildingCount = slugs.size;
const articleCount = allPosts.length;
---
<BaseLayout title="Built Japan" lang={lang} altPath="/">
  <section class="home-hero">
    <div class="home-hero-inner" data-reveal>
      <p class="eyebrow">{t('home.eyebrow')}</p>
      <h1>{t('home.title')}</h1>
      <p class="home-hero-desc">{t('home.desc')}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/en/database/">{t('home.cta.database')}</a>
        <a class="btn btn-ghost" href="/rankings/">{t('home.cta.rankings')}</a>
      </div>
      <ul class="hero-stats">
        <li><b>{buildingCount}</b><span>{t('home.stat.buildings')}</span></li>
        <li><b>{articleCount}</b><span>{t('home.stat.articles')}</span></li>
        <li><b>JP / EN</b><span>{t('home.stat.bilingual')}</span></li>
      </ul>
    </div>
    <div class="hero-skyline" aria-hidden="true"></div>
  </section>

  <div class="section-head" data-reveal>
    <h2>{t('home.section.feed')}</h2>
    <p>{t('home.section.feed.desc')}</p>
  </div>

  <section class="grid grid-2">
    {latest.map((post) => <PostCard lang={lang} post={post} />)}
  </section>

  <nav class="feed-more" aria-label={t('footer.categories')}>
    <a href="/en/buildings/">{t('nav.home')}</a>
    <a href="/en/expressways/">{CATEGORIES.expressways.label.en}</a>
    <a href="/en/railways/">{CATEGORIES.railways.label.en}</a>
  </nav>
</BaseLayout>
