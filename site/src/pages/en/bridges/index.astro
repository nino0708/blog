---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BuildingCard from '../../../components/BuildingCard.astro';
import Pager from '../../../components/Pager.astro';
import AreaFilter from '../../../components/AreaFilter.astro';
import { buildAreaFacets } from '../../../lib/area';
import { useT } from '../../../i18n/ui';
import { BRIDGES, getBridgeEntries, areaKeysForBuildings } from '../../../lib/category';

const lang = 'en';
const t = useT(lang);

// 英語版は翻訳済み(buildings-en)の橋のみ掲載。数値・公開日・写真はJP版から補う。
const jp = await getBridgeEntries();
const jpBySlug = new Map(jp.map((p) => [p.slug, p]));
const allPosts = (await getCollection('buildings-en'))
  .filter((en) => jpBySlug.has(en.slug))
  .map((en) => ({ en, jp: jpBySlug.get(en.slug)! }))
  .sort((a, b) => b.jp.data.publishedAt.valueOf() - a.jp.data.publishedAt.valueOf());

const PER_PAGE = 10;
const totalPages = Math.max(1, Math.ceil(allPosts.length / PER_PAGE));
// エリアは英語版の area 表記ではなく日本語版から割り出し、チップの表示名だけ英語にする。
const areaKeys = areaKeysForBuildings(jp);
const areaFacets = buildAreaFacets(allPosts.map((x) => areaKeys.get(x.en.slug) ?? []), lang);
---
<BaseLayout
  title={BRIDGES.label.en}
  description={BRIDGES.description.en}
  lang={lang}
  altPath="/bridges/"
>
  <div class="section-head section-head-sub" data-reveal>
    <p class="crumb"><a href="/en/">{t('breadcrumb.home')}</a></p>
    <h1>{BRIDGES.label.en}</h1>
    <p>{BRIDGES.description.en}</p>
  </div>

  <AreaFilter lang={lang} facets={areaFacets} total={allPosts.length} perPage={PER_PAGE} />

  <section class="grid grid-2">
    {allPosts.map(({ en, jp }, i) => (
      <BuildingCard
        lang={lang}
        url={`/en/buildings/${en.slug}/`}
        title={en.data.title}
        buildingType={jp.data.buildingType}
        area={en.data.area}
        completedYear={jp.data.completedYear}
        heightM={jp.data.heightM}
        summary={en.data.summary}
        verified={jp.data.verified}
        heroImage={jp.data.heroImage}
        areas={areaKeys.get(en.slug)}
        areaExtra={i >= PER_PAGE}
      />
    ))}
  </section>

  <div data-area-pager>
    <Pager current={1} total={totalPages} basePath="/en/bridges/" lang={lang} />
  </div>
</BaseLayout>
