---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NearView from '../../components/NearView.astro';

const title = 'Find buildings near a place | Built Japan';
const description =
  'Enter your home, a station or any place in Tokyo and see the high-rise buildings around it, sorted by distance and plotted on a map — with walking estimates, so you can plan a day of building-spotting.';
---
<BaseLayout title={title} description={description} lang="en" altPath="/near/" appendSiteName={false}>
  <p class="breadcrumb"><a href="/en/">Articles</a> ／ Nearby</p>
  <NearView lang="en" />
</BaseLayout>
