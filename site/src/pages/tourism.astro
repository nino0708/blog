---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryView from '../components/CategoryView.astro';
import { buildAreaFacets } from '../lib/area';
import { CATEGORIES, PER_PAGE, getCategoryPosts } from '../lib/category';

const meta = CATEGORIES.tourism;
// 新着順。観光コレクションに加え「観光」タグ付きの建物(東京タワー・橋など)も合流する。
// 2ページ目以降は /tourism/page/N/ が担う(トップの新着一覧と同じ1ページ10件)。
const all = await getCategoryPosts('tourism');
const totalPages = Math.max(1, Math.ceil(all.length / PER_PAGE));
// エリア絞り込みは全記事から選ぶので一覧は全件出力し、先頭 PER_PAGE 件だけを見せる。
const areaFacets = buildAreaFacets(all.map((p) => p.areas), 'ja');
---
<BaseLayout
  title={`${meta.label.ja}｜関東のインフラ`}
  description={meta.description.ja}
  lang="ja"
  appendSiteName={false}
>
  <CategoryView
    lang="ja"
    title={meta.label.ja}
    description={meta.description.ja}
    posts={all}
    areaFacets={areaFacets}
    perPage={PER_PAGE}
    basePath="/tourism/"
    current={1}
    totalPages={totalPages}
  />
</BaseLayout>
