---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DatabaseView from '../../components/DatabaseView.astro';
import { langPaths, localizePath, type Lang } from '../../i18n/ui';
import { getBuildingPosts } from '../../lib/content';

export function getStaticPaths() {
  return langPaths();
}

const { lang } = Astro.props as { lang: Lang };

const copy = {
  ja: {
    title: '建物図鑑｜東京の高層建築データベース',
    description:
      '東京を中心とした高層オフィスビル・タワーマンション・タワーを一棟ずつ集めた、検索・並べ替えできる建物データベース（百科事典）。竣工年・高さ・エリアから引けます。',
    listName: '東京の高層建築 建物図鑑',
    crumb: ['ホーム', '建物図鑑'],
  },
  en: {
    title: 'Building Database | Tokyo High-rise Architecture',
    description:
      'A searchable database (encyclopedia) of Tokyo’s high-rise office towers, residential towers and structures — building by building. Look them up by completion year, height and area.',
    listName: 'Tokyo High-rise Building Database',
    crumb: ['Articles', 'Building Database'],
  },
}[lang];

// 図鑑に載る「記事のある建物」を ItemList 構造化データで列挙（内部リンク強化・SEO）。
const articles = await getBuildingPosts(lang);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: copy.listName,
  numberOfItems: articles.length,
  itemListElement: articles.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: a.title,
    url: `https://builtjapan.com${a.href}`,
  })),
};
---
<BaseLayout title={copy.title} description={copy.description} lang={lang} altPath={localizePath(lang === 'ja' ? 'en' : 'ja', '/database/')} appendSiteName={false} jsonLd={jsonLd}>
  <p class="breadcrumb"><a href={localizePath(lang, '/')}>{copy.crumb[0]}</a> ／ {copy.crumb[1]}</p>
  <DatabaseView lang={lang} />
</BaseLayout>
