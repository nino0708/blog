---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StampBook from '../../components/StampBook.astro';
import { langPaths, localizePath, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return langPaths();
}

const { lang } = Astro.props as { lang: Lang };

const copy = {
  ja: {
    title: 'スタンプ帳｜東京の高層建築スタンプラリー',
    description:
      '実際に行った高層ビル・タワーマンションにスタンプを押して、東京の高層建築をどれだけ回れたか（踏破率）を記録できる自己申告制スタンプラリー。ログイン不要、記録はお使いの端末にだけ保存されます。',
    crumb: ['ホーム', 'スタンプ帳'],
  },
  en: {
    title: 'Stamp Book | Tokyo High-rise Stamp Rally',
    description:
      'A self-reported stamp rally for Tokyo’s high-rises: stamp the buildings you have actually visited and track your completion rate. No sign-in — your record stays on your own device.',
    crumb: ['Articles', 'Stamp Book'],
  },
}[lang];
---
<BaseLayout title={copy.title} description={copy.description} lang={lang} altPath={localizePath(lang === 'ja' ? 'en' : 'ja', '/stamps/')} appendSiteName={false}>
  <p class="breadcrumb"><a href={localizePath(lang, '/')}>{copy.crumb[0]}</a> ／ {copy.crumb[1]}</p>
  <StampBook lang={lang} />
</BaseLayout>
