---
// サイト内検索の結果ページ(/search/?q=)。検索はブラウザ側で行う(src/scripts/search.ts)。
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useT, langPaths, localizePath, type Lang } from '../../i18n/ui';
import { BUILD_ID } from '../../lib/build';

export function getStaticPaths() {
  return langPaths();
}

const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const labels = {
  empty: t('search.empty'),
  more: t('search.more'),
  stub: t('search.stub'),
  count: t('search.count'),
  all: t('search.all'),
};
---
<BaseLayout title={t('search.title')} description={t('search.lead')} lang={lang} altPath={localizePath(lang === 'ja' ? 'en' : 'ja', '/search/')} noindex={true}>
  <section
    class="search-page"
    data-search-page
    data-index={`${localizePath(lang, '/search-index.json')}?v=${BUILD_ID}`}
    data-lang={lang}
    data-labels={JSON.stringify(labels)}
  >
    <h1>{t('search.title')}</h1>
    <p class="lead">{t('search.lead')}</p>
    <form class="search-page-form" role="search" action={localizePath(lang, '/search/')} method="get">
      <label class="visually-hidden" for="search-page-q">{t('search.label')}</label>
      <input id="search-page-q" type="search" name="q" placeholder={t('search.placeholder')} autocomplete="off" />
      <button class="btn btn-primary" type="submit">{t('nav.search')}</button>
    </form>
    <div class="search-chips" data-search-chips></div>
    <p class="search-count" data-search-count aria-live="polite"></p>
    <ul class="search-results" data-search-results></ul>
  </section>
</BaseLayout>

<script>
  import '../../scripts/search';
</script>
