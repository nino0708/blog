---
// 旧URLの転送: トップを「新着」にする前の建物一覧のページ送り(/page/N/)を /buildings/page/N/ へ逃がす。
// 静的サイトなので meta refresh + canonical で転送する(検索エンジンは canonical で新URLに寄せる)。
import { langParam } from '../../../i18n/ui';
import { listPages, listPath } from '../../../lib/lists';

export async function getStaticPaths() {
  return (await listPages())
    .filter((p) => p.list.key === 'buildings' && p.page > 1)
    .map((p) => ({ params: { lang: langParam(p.lang), page: String(p.page) }, props: { to: listPath(p.lang, 'buildings', p.page) } }));
}

const to = new URL(Astro.props.to, Astro.site ?? 'https://example.com').toString();
---
<!doctype html><title>Redirecting to: {to}</title><meta http-equiv="refresh" content={`0;url=${to}`}><meta name="robots" content="noindex"><link rel="canonical" href={to}><body>	<a href={to}>Redirecting from <code>{Astro.url.pathname}</code> to <code>{to}</code></a></body>
