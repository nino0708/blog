---
// トップ(新着)。全カテゴリから直近10本を新しい順に出す。
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { useT, langPaths, localizePath, type Lang } from '../../i18n/ui';
import { getAllPosts } from '../../lib/content';
import { getBuildingRows } from '../../lib/buildings';
import { BRIDGES, CATEGORIES } from '../../lib/category';

export function getStaticPaths() {
  return langPaths();
}


const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const L = (p: string) => localizePath(lang, p);

const allPosts = await getAllPosts(lang);
const latest = allPosts.slice(0, 10);
// 建物の収録数は言語共通の母数(図鑑と同じ: レジストリ ∪ 記事)。記事数はこの言語の本数。
const buildingCount = (await getBuildingRows(lang)).length;
const articleCount = allPosts.length;
---
<BaseLayout title="Built Japan" lang={lang} altPath={localizePath(lang === 'ja' ? 'en' : 'ja', '/')}>
  <section class="home-hero">
    <div class="home-hero-inner" data-reveal>
      <p class="eyebrow">{t('home.eyebrow')}</p>
      <h1>{t('home.title')}</h1>
      <p class="home-hero-desc">{t('home.desc')}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={L('/database/')}>{t('home.cta.database')}</a>
        <a class="btn btn-ghost" href="/rankings/">{t('home.cta.rankings')}</a>
      </div>
      <ul class="hero-stats">
        <li><b>{buildingCount}</b><span>{t('home.stat.buildings')}</span></li>
        <li><b>{articleCount}</b><span>{t('home.stat.articles')}</span></li>
        <li><b>JP / EN</b><span>{t('home.stat.bilingual')}</span></li>
      </ul>
    </div>
    <p class="hero-credit">{t('home.hero.credit')}: <a href="https://commons.wikimedia.org/wiki/File:Tokyo,_Japan_is_seen_from_a_U.S._Nighthawk_helicopter_(54883848249).jpg" target="_blank" rel="noopener">The White House</a>{t('home.hero.credit.suffix')}</p>
  </section>

  <div class="section-head" data-reveal>
    <h2>{t('home.section.feed')}</h2>
    <p>{t('home.section.feed.desc')}</p>
  </div>

  <section class="grid grid-2">
    {latest.map((post, i) => <PostCard lang={lang} post={post} priority={i === 0} />)}
  </section>

  <nav class="feed-more" aria-label={t('footer.categories')}>
    <a href={L('/buildings/')}>{t('nav.home')}</a>
    <a href={L('/expressways/')}>{CATEGORIES.expressways.label[lang]}</a>
    <a href={L('/railways/')}>{CATEGORIES.railways.label[lang]}</a>
    <a href={L('/bridges/')}>{BRIDGES.label[lang]}</a>
    {lang === 'ja' && <a href="/tourism/">{CATEGORIES.tourism.label.ja}</a>}
  </nav>
</BaseLayout>
