---
import BaseLayout from '../layouts/BaseLayout.astro';
import StampBook from '../components/StampBook.astro';

const title = 'スタンプ帳｜東京の高層建築スタンプラリー';
const description =
  '実際に行った高層ビル・タワーマンションにスタンプを押して、東京の高層建築をどれだけ回れたか（踏破率）を記録できる自己申告制スタンプラリー。ログイン不要、記録はお使いの端末にだけ保存されます。';
---
<BaseLayout title={title} description={description} lang="ja" altPath="/en/stamps/" appendSiteName={false}>
  <p class="breadcrumb"><a href="/">記事一覧</a> ／ スタンプ帳</p>
  <StampBook lang="ja" />
</BaseLayout>
