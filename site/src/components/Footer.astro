---
// フッター。メニュー構成は src/lib/nav.ts(ヘッダーと共通)。
import { useT, localizePath, type Lang } from '../i18n/ui';
import { readItems, toolItems, aboutItems } from '../lib/nav';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-cols">
      <div class="footer-brand">
        <a href={localizePath(lang, '/')} class="brand"><Logo size={24} /><span class="brand-text">Built <span>Japan</span></span></a>
        <p class="disclaimer">{t('footer.disclaimer')}</p>
      </div>

      <nav class="footer-col" aria-label={t('nav.read')}>
        <h2>{t('nav.read')}</h2>
        <ul>
          <li><a href={localizePath(lang, '/')}>{t('nav.latest')}</a></li>
          {readItems(lang).map((i) => <li><a href={i.href}>{i.label}</a></li>)}
        </ul>
      </nav>

      <nav class="footer-col" aria-label={t('nav.tools')}>
        <h2>{t('nav.tools')}</h2>
        <ul>
          {toolItems(lang).map((i) => <li><a href={i.href}>{i.label}</a></li>)}
          <li><a href={localizePath(lang, '/search/')}>{t('nav.search')}</a></li>
        </ul>
      </nav>

      <nav class="footer-col" aria-label={t('footer.follow')}>
        <h2>{t('footer.follow')}</h2>
        <ul>
          <li><a href="https://x.com/builtjapan" target="_blank" rel="noopener">{t('footer.x')}</a></li>
          {aboutItems(lang).map((i) => <li><a href={i.href}>{i.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">© {year} Built Japan — {t('site.tagline')}</div>
  </div>
</footer>
