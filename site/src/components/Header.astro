---
import { useT, localizePath, type Lang } from '../i18n/ui';
import { BRIDGES, CATEGORIES } from '../lib/category';

interface Props {
  lang: Lang;
  /** もう一方の言語での同一ページのパス。無ければその言語のトップへ。 */
  altPath?: string | null;
}
const { lang, altPath = null } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'ja' ? 'en' : 'ja';
const switchHref = altPath ?? localizePath(other, '/');

// 現在地の判定。トップ(/ , /en/)は完全一致、それ以外は配下のページ(記事詳細など)も親を選択中にする。
const home = localizePath(lang, '/');
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === home ? path === href : path.startsWith(href));
---
<header class="site-header">
  <div class="container inner">
    <a href={home} class="brand">
      <svg class="brand-mark" width="22" height="24" viewBox="0 0 22 24" aria-hidden="true">
        <rect x="2" y="9" width="6" height="14" rx="1" fill="var(--brand)" opacity="0.55" />
        <rect x="14" y="6" width="6" height="17" rx="1" fill="var(--brand)" opacity="0.75" />
        <rect x="8.5" y="1" width="5" height="22" rx="1" fill="var(--gold)" />
      </svg>
      <span class="brand-text">Built <span>Japan</span></span>
    </a>
    <nav class="nav">
      {/* 読むもの: 新着とカテゴリ別の記事一覧 */}
      <a href={home} aria-current={isCurrent(home) ? 'page' : undefined}>{t('nav.latest')}</a>
      {[
        ['/buildings/', t('nav.home')],
        ['/expressways/', CATEGORIES.expressways.label[lang]],
        ['/railways/', CATEGORIES.railways.label[lang]],
        ['/bridges/', BRIDGES.label[lang]],
      ].map(([p, label]) => {
        const href = localizePath(lang, p);
        return <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>;
      })}
      {/* 観光は日本語版のみ（英語コレクション未整備） */}
      {lang === 'ja' && (
        <a href="/tourism/" aria-current={isCurrent('/tourism/') ? 'page' : undefined}>{CATEGORIES.tourism.label.ja}</a>
      )}

      <span class="nav-sep" aria-hidden="true"></span>

      {/* 引く・使うもの */}
      {lang === 'ja' && <a href="/rankings/" aria-current={isCurrent('/rankings/') ? 'page' : undefined}>ランキング</a>}
      {[
        ['/database/', t('nav.database')],
        ['/near/', t('nav.near')],
        ['/stamps/', t('nav.stamps')],
      ].map(([p, label]) => {
        const href = localizePath(lang, p);
        return <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>;
      })}

      <span class="nav-sep" aria-hidden="true"></span>

      <a href={localizePath(lang, '/about/')} aria-current={isCurrent(localizePath(lang, '/about/')) ? 'page' : undefined}>{t('nav.about')}</a>
      <a class="lang-switch" href={switchHref} hreflang={other} lang={other}>{t('lang.other')}</a>
    </nav>
  </div>
</header>
